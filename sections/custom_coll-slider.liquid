<style>
  span.cart_btn {
    display: block;
    background: #000;
    width: 100%;
    max-width: 180px;
    height: 52px;
    color: #fff;
    text-align: center;
    vertical-align: middle;
    line-height: 52px;
    cursor: pointer;
    border-radius: 5px;
}
.featured_coll{
			display: none;
			background: #ededed;
			padding: 15px;
		}

		.featured_coll.current{
			display: inherit;
		}
        img.prdct_img {
    width: 100%;
}
</style>