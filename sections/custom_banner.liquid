<div class="custom_banner">
<div class="banner_outer" style="background-image:url('{{ section.settings.image | img_url:'master' }}');">
<div class="text_sec">
<div class="container page-width">
<h3>{{ section.settings.heading }}</h3>
<div class="text">
{{ section.settings.text }}
</div>
<div class="form_sec">
<form action="/search" method="get" role="search">
<input type="search" name="q" placeholder="Search Furniture" aria-label="Search store">
<button type="submit">Search</button>
</form>
</div>
</div>
</div>
</div>
</div>

    {% schema %}
    {
    "name":"Custom Banner",
    "settings":[
    {
    "type":"image_picker",
    "id":"image",
    "label":"Image"
    },
    {
    "type":"text",
    "id":"heading",
    "label":"Heading"
    },
    {
    "type":"textarea",
    "id":"text",
    "label":"Text"
    }
    ],
    "presets":[
        {
            "name":"Custom Banner",
            "settings":{}
    }
]
    }
    {% endschema %}

    <style>
.banner_outer {
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    height: 850px;
}

.banner_outer .text_sec {
    text-align: center;
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    bottom: 0;
    transform: translate(0,-50%);
}

.custom_banner {
    position: relative;
}

.banner_outer {}
    </style>